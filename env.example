# Server
DATABASE_URL="postgresql://overphone:change-me@localhost:5432/overphone?schema=public"
SESSION_SECRET="replace-with-a-random-32-byte-secret"
CLIENT_ORIGIN="https://app.example.com"
PORT=3001
NODE_ENV=development
# Transactional email used for password reset (Resend HTTP API)
RESEND_API_KEY=
EMAIL_FROM="OverPhone <security@example.com>"
# Web Push (generate with: npx web-push generate-vapid-keys)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT="mailto:admin@example.com"
# TURN is required in production for users behind restrictive NATs.
TURN_SERVER_URL="turn:turn.example.com:3478"
TURN_USERNAME=
TURN_PASSWORD=
